{
  "name": "otty-assistant",
  "productName": "Otty",
  "version": "0.5.0",
  "description": "A cute otter AI assistant that lives at your cursor.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "predev": "node tools/otty-ocr/build.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "eval": "vitest run --config tools/eval/vitest.config.ts",
    "eval:compare": "node tools/eval/compare.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:mac": "node tools/otty-ocr/build.mjs && electron-vite build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438"
  }
}
