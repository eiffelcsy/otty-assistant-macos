{
  "name": "otty-assistant",
  "productName": "Otty",
  "version": "0.5.0",
  "description": "A cute otter AI assistant that lives at your cursor.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "predev": "node tools/otty-ocr/build.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:smoke": "node tools/otty-ocr/build.mjs && electron-vite build && vite build -c tools/smoke/vite.entry.config.mts --logLevel warn",
    "smoke": "node tools/smoke/run.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage && node tools/verify/coverage.mjs",
    "eval": "vitest run --config tools/eval/vitest.config.ts",
    "eval:compare": "node tools/eval/compare.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "node tools/verify/lint.mjs",
    "knip": "knip --no-progress",
    "verify": "node tools/verify/verify.mjs standard",
    "verify:quick": "node tools/verify/verify.mjs quick",
    "verify:full": "node tools/verify/verify.mjs full",
    "build:mac": "node tools/otty-ocr/build.mjs && electron-vite build && electron-builder --mac --publish never",
    "risk": "node tools/verify/risk.mjs",
    "screens": "playwright test -c tools/ui-preview/screens/playwright.config.ts",
    "screens:update": "node tools/ui-preview/screens/from-ci.mjs",
    "smoke:packaged": "node tools/smoke/packaged.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "dompurify": "3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "katex": "^0.19.1",
    "knip": "6.45.1",
    "mathjs": "^15.2.0",
    "mermaid": "12.3.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~7.0.2",
    "undici": "7.30.1",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438"
  }
}
